# Neon pooled connection string. Never commit the real value.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate at least 32 random bytes and keep the value private.
AUTH_COOKIE_SECRET=CHANGE_ME

# Used only by `npm run db:create-user`; do not expose these to the browser.
EMI_ADMIN_USERNAME=owner
EMI_ADMIN_PASSWORD=CHANGE_ME
EMI_ADMIN_DISPLAY_NAME=Portfolio owner

# Private Vercel Blob store. Pass upload inputs as command arguments or as a
# platform-delimited list in BLOB_SOURCE_PATHS.
BLOB_READ_WRITE_TOKEN=CHANGE_ME
BLOB_SOURCE_PATHS=/absolute/path/to/source/files
